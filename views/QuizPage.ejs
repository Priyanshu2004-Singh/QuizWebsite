<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= quiz.title %> - Take Quiz</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/app.css?v=2" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/quiz">Quizzes</a>
        <span class="chip">Taking quiz</span>
      </div>
      <div class="nav-right">
        <a class="button-secondary" href="/user/results">My Results</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <section class="hero-shell fade-in-up stagger-1">
      <div class="hero-copy">
        <div class="hero-kicker">Quiz</div>
        <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 3.2rem);"><span class="gradient-text"><%= quiz.title %></span></h1>
        <p class="hero-text">Answer each question and submit when you’re ready.</p>
      </div>
    </section>

    <section class="section fade-in-up stagger-2">
      <form action="/user/submit-quiz/<%= quiz.id %>" method="POST" class="content-stack">
        <% questions.forEach((q, index) => { %>
          <article class="panel" style="padding: 1.25rem;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap: 1rem; flex-wrap: wrap;">
              <h2 style="margin: 0; font-size: 1.1rem;">Q<%= index + 1 %>. <%= q.question_text %></h2>
              <div style="display:flex; gap:0.5rem; align-items:center;">
                <span class="chip">ID: <%= q.id %></span>
                <% if (q.difficulty) { %>
                  <span class="badge"><%= q.difficulty %></span>
                <% } %>
              </div>
            </div>

            <div class="card-stack" style="margin-top: 1rem;">
              <label class="quiz-option" style="padding: 0.85rem 1rem; display:flex; gap: 0.75rem; align-items: flex-start;">
                <input type="radio" name="answers[<%= q.id %>]" value="A" required style="margin-top: 0.25rem;" />
                <span><strong>A.</strong> <%= q.option_a %></span>
              </label>
              <label class="quiz-option" style="padding: 0.85rem 1rem; display:flex; gap: 0.75rem; align-items: flex-start;">
                <input type="radio" name="answers[<%= q.id %>]" value="B" style="margin-top: 0.25rem;" />
                <span><strong>B.</strong> <%= q.option_b %></span>
              </label>
              <label class="quiz-option" style="padding: 0.85rem 1rem; display:flex; gap: 0.75rem; align-items: flex-start;">
                <input type="radio" name="answers[<%= q.id %>]" value="C" style="margin-top: 0.25rem;" />
                <span><strong>C.</strong> <%= q.option_c %></span>
              </label>
              <label class="quiz-option" style="padding: 0.85rem 1rem; display:flex; gap: 0.75rem; align-items: flex-start;">
                <input type="radio" name="answers[<%= q.id %>]" value="D" style="margin-top: 0.25rem;" />
                <span><strong>D.</strong> <%= q.option_d %></span>
              </label>
            </div>
          </article>
        <% }) %>

        <div class="sticky-bar">
          <div class="panel" style="padding: 1rem; display:flex; align-items:center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <span class="muted">Make sure every question has an answer.</span>
            <button type="submit" class="button-primary">Submit quiz</button>
          </div>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">Submitting saves your attempt.</div>
      <div class="footer-note text-right">Good luck.</div>
    </div>
  </footer>
</body>
</html>
