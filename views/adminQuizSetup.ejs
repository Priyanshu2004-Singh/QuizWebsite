<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Quiz Setup | QuizMaster</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/admin">Admin</a>
        <span class="chip">Create quiz</span>
      </div>
      <div class="nav-right">
        <a class="secondary-btn" href="/admin">Dashboard</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <% if ((success && success.length) || (error && error.length)) { %>
      <% if (success && success.length) { %>
        <div class="flash-shell flash-success"><%= Array.isArray(success) ? success.join(' ') : success %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="flash-shell flash-error"><%= Array.isArray(error) ? error.join(' ') : error %></div>
      <% } %>
    <% } %>

    <section class="form-shell narrow">
      <h1 class="form-title">Quiz setup</h1>
      <p class="form-subtitle">Choose how many questions and the marks per question.</p>

      <form action="/admin/create-quiz" method="GET" class="form-stack">
        <div class="form-stack">
          <label>Number of questions</label>
          <input type="number" name="count" min="1" max="50" required />
        </div>

        <div class="form-stack">
          <label>Marks per question</label>
          <input type="number" name="marks" min="1" required />
        </div>

        <div class="btn-row" style="justify-content: space-between; align-items: center;">
          <button type="submit" class="button-primary">Continue</button>
          <a class="button-secondary" href="/admin">Cancel</a>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">Quiz creation is a 2-step flow.</div>
      <div class="footer-note text-right">Setup → enter questions → submit.</div>
    </div>
  </footer>
</body>
</html>
