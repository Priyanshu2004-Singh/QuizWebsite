<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Quiz | QuizMaster</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/admin">Admin</a>
        <span class="chip">Create quiz</span>
      </div>
      <div class="nav-right">
        <a class="secondary-btn" href="/admin">Dashboard</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <section class="hero-shell">
      <div class="hero-copy">
        <div class="hero-kicker">Step 2</div>
        <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 3.2rem);">Create quiz</h1>
        <p class="hero-text">Questions: <strong><%= count %></strong> • Marks per question: <strong><%= marks %></strong></p>
      </div>
    </section>

    <section class="section">
      <form action="/admin/create-quiz" method="POST" class="content-stack">
        <input type="hidden" name="marks" value="<%= marks %>">
        <input type="hidden" name="count" value="<%= count %>">

        <div class="panel" style="padding: 1.25rem;">
          <div class="form-stack">
            <label>Quiz title</label>
            <input type="text" name="title" required />
          </div>
        </div>

        <% for (let i = 0; i < count; i++) { %>
          <div class="panel" style="padding: 1.25rem;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap: 1rem; flex-wrap: wrap;">
              <h2 style="margin: 0; font-size: 1.15rem;">Question <%= i + 1 %></h2>
              <span class="chip">Q<%= i + 1 %></span>
            </div>

            <div class="form-stack" style="margin-top: 1rem;">
              <label>Question</label>
              <input type="text" name="questions[<%= i %>][question]" required />
            </div>

            <div class="form-stack" style="margin-top: 1rem;">
              <label>Option A</label>
              <input type="text" name="questions[<%= i %>][options][]" required />
            </div>
            <div class="form-stack">
              <label>Option B</label>
              <input type="text" name="questions[<%= i %>][options][]" required />
            </div>
            <div class="form-stack">
              <label>Option C</label>
              <input type="text" name="questions[<%= i %>][options][]" required />
            </div>
            <div class="form-stack">
              <label>Option D</label>
              <input type="text" name="questions[<%= i %>][options][]" required />
            </div>

            <div class="form-stack" style="margin-top: 1rem;">
              <label>Correct option (A/B/C/D)</label>
              <input type="text" name="questions[<%= i %>][correct]" maxlength="1" required style="max-width: 120px; text-transform: uppercase;" />
            </div>
          </div>
        <% } %>

        <div class="sticky-bar">
          <div class="panel" style="padding: 1rem; display:flex; align-items:center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <span class="muted">Review answers carefully before submitting.</span>
            <button type="submit" class="button-primary">Submit quiz</button>
          </div>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">Created quizzes appear on the home page.</div>
      <div class="footer-note text-right">Then users can attempt them instantly.</div>
    </div>
  </footer>
</body>
</html>
