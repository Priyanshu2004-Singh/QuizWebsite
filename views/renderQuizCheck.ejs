<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Check Quiz Evaluations</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <div class="page-shell main">
    <header class="section">
      <h1 class="section-title">📊 Quiz Evaluations</h1>
    </header>

    <section class="section">
      <% if (!quizzes || quizzes.length === 0) { %>
        <div class="panel empty-state">No quizzes found.</div>
      <% } else { %>
        <div class="quiz-grid">
          <% quizzes.forEach(quiz => { %>
            <div class="quiz-card">
              <div>
                <div class="muted">ID: <%= quiz.id %></div>
                <h3><%= quiz.title %></h3>
                <div class="muted">
                  <% if (quiz.total_questions) { %>
                    <span>❓ <%= quiz.total_questions %> q</span>
                  <% } %>
                  <% if (quiz.marks_per_question) { %>
                    <span style="margin-left:0.5rem;">📝 <%= quiz.marks_per_question %>/q</span>
                  <% } %>
                </div>
              </div>
              <div style="text-align:right;">
                <a class="secondary-btn" href="/admin/quiz/<%= quiz.id %>/result">🔍 Check Evaluation</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</body>
</html>
