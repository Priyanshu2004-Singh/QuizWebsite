<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Quiz History</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <div class="page-shell main">
    <header class="section">
      <h1 class="section-title">📚 All Created Quizzes</h1>
    </header>

    <section class="section">
      <div class="panel">
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Total Questions</th>
                <th>Marks/Question</th>
                <th>Created By</th>
                <th>Created At</th>
              </tr>
            </thead>
            <tbody>
              <% if (quizzes && quizzes.length > 0) { %>
                <% quizzes.forEach(quiz => { %>
                  <tr>
                    <td><%= quiz.id %></td>
                    <td><strong><%= quiz.title %></strong></td>
                    <td><%= quiz.total_questions %></td>
                    <td><%= quiz.marks_per_question %></td>
                    <td><%= quiz.created_by || 'Unknown' %></td>
                      <td><%= new Date(quiz.created_at).toLocaleString() %></td>
                      <td><a class="secondary-btn" href="/admin/quiz/<%= quiz.id %>/detail">Report</a></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="muted">No quizzes found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</body>
</html>
