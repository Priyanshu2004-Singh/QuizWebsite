<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin | Quiz Feedbacks</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/admin">Admin</a>
        <span class="chip">Feedbacks</span>
      </div>
      <div class="nav-right">
        <a class="secondary-btn" href="/admin">Dashboard</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <section class="section">
      <h1 class="section-title">Quiz Feedbacks</h1>

      <% if (!feedbacks || feedbacks.length === 0) { %>
        <div class="panel empty-state">No feedbacks submitted yet.</div>
      <% } else { %>
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th>User ID</th>
                <th>Quiz ID</th>
                <th>Feedback</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% feedbacks.forEach(f => { %>
                <tr>
                  <td><%= f.user_id %></td>
                  <td><%= f.quiz_id %></td>
                  <td class="truncate" title="<%= f.message %>"><%= f.message %></td>
                  <td>
                    <form action="/admin/feedbacks/delete/<%= f.id %>" method="POST" onsubmit="return confirm('Delete this feedback?')">
                      <button type="submit" class="button-secondary">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
