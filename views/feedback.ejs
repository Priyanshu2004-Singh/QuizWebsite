<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Feedback | QuizMaster</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/">QuizMaster</a>
        <span class="chip">Feedback</span>
      </div>
      <div class="nav-right">
        <a class="secondary-btn" href="/quiz">Quizzes</a>
        <a class="secondary-btn" href="/user/results">My Results</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <% if (messages?.success?.length || messages?.error?.length || (success && success.length) || (error && error.length)) { %>
      <% if (messages?.success?.length) { %>
        <div class="flash-shell flash-success"><%= messages.success.join(' ') %></div>
      <% } else if (success && success.length) { %>
        <div class="flash-shell flash-success"><%= Array.isArray(success) ? success.join(' ') : success %></div>
      <% } %>
      <% if (messages?.error?.length) { %>
        <div class="flash-shell flash-error"><%= messages.error.join(' ') %></div>
      <% } else if (error && error.length) { %>
        <div class="flash-shell flash-error"><%= Array.isArray(error) ? error.join(' ') : error %></div>
      <% } %>
    <% } %>

    <section class="form-shell narrow">
      <h1 class="form-title">Submit feedback</h1>
      <p class="form-subtitle">Help improve the quiz experience.</p>

      <div class="panel" style="padding: 1rem; margin-bottom: 1rem;">
        <div class="muted">Quiz</div>
        <div style="font-weight: 700; margin-top: 0.25rem;"><%= quiz.title %></div>
      </div>

      <form action="/feedback/<%= quiz.id %>" method="POST" class="form-stack">
        <div class="form-stack">
          <label for="message">Your feedback</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <div class="btn-row" style="justify-content: space-between; align-items: center;">
          <button type="submit" class="button-primary">Send feedback</button>
          <a class="button-secondary" href="/">Back home</a>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">Thanks for helping improve QuizMaster.</div>
      <div class="footer-note text-right">Feedback is stored per quiz.</div>
    </div>
  </footer>
</body>
</html>
