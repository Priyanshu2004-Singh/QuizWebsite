<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Results | QuizMaster</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/app.css?v=2" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/">QuizMaster</a>
        <span class="chip">Results</span>
      </div>
      <div class="nav-right">
        <a class="button-secondary" href="/quiz">Quizzes</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <section class="hero-shell">
      <div class="hero-copy">
        <div class="hero-kicker">Performance</div>
        <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 3.2rem);">Your quiz results</h1>
        <p class="hero-text">Track your attempts and improve over time.</p>

        <p class="muted" style="margin: 1rem 0 0;">Hello <strong><%= username %></strong>.</p>
      </div>
    </section>

    <section class="section">
      <div class="metric-grid">
        <div class="metric-card">
          <div class="metric-label">Attempts</div>
          <div class="metric-value"><%= summary?.attempts ?? (results ? results.length : 0) %></div>
          <div class="metric-note">Total submissions</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Best Score</div>
          <div class="metric-value"><%= summary?.bestScore ?? 0 %></div>
          <div class="metric-note">Highest score achieved</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Average Score</div>
          <div class="metric-value"><%= summary?.averageScore ?? '0.0' %></div>
          <div class="metric-note">Across all attempts</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <div class="section-kicker">History</div>
          <h2 class="section-title">Attempts</h2>
          <p class="section-text">Most recent attempts first.</p>
        </div>
        <div>
          <a class="button-primary" href="/quiz">Take another quiz</a>
        </div>
      </div>

      <% if (!results || results.length === 0) { %>
        <div class="panel empty-state">
          You haven’t attempted any quizzes yet.
        </div>
      <% } else { %>
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Quiz</th>
                <th>Score</th>
                <th>Attempted</th>
              </tr>
            </thead>
            <tbody>
              <% results.forEach((row, index) => { 
                const score = Number(row.score || 0);
                const total = Number(row.total_marks || 0);
                const pct = total > 0 ? (score / total) : 0;
                const badgeClass = pct >= 0.8 ? 'badge-success' : (pct >= 0.5 ? 'badge-warning' : 'badge-danger');
              %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td class="truncate" title="<%= row.title %>"><%= row.title %></td>
                  <td>
                    <span class="badge <%= badgeClass %>"><%= score %></span>
                    <span class="muted"> / <%= total %></span>
                  </td>
                  <td><%= row.started_at ? new Date(row.started_at).toLocaleString() : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">Keep practicing — results improve fast.</div>
      <div class="footer-note text-right">Your attempts are saved per account.</div>
    </div>
  </footer>
</body>
</html>
