<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>QuizMaster | Learn & Test</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css?v=2" />
</head>
<body>
  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/">QuizMaster</a>
        <span class="chip">Practice • Improve • Repeat</span>
      </div>
      <div class="nav-right">
        <a class="button-secondary" href="/quiz">Quizzes</a>
        <% if (username) { %>
          <a class="button-secondary" href="/user/results">My Results</a>
          <% if (role === 'admin') { %>
            <a class="button-secondary" href="/admin">Admin</a>
          <% } %>
          <a class="button-secondary" href="/logout">Logout</a>
        <% } else { %>
          <a class="button-secondary" href="/login">Login</a>
          <a class="button-primary" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <% if (messages?.success?.length || messages?.error?.length) { %>
    <div class="page-shell">
      <% if (messages?.success?.length) { %>
        <div class="flash-shell flash-success">
          <%= messages.success.join(' ') %>
        </div>
      <% } %>
      <% if (messages?.error?.length) { %>
        <div class="flash-shell flash-error">
          <%= messages.error.join(' ') %>
        </div>
      <% } %>
    </div>
  <% } %>

  <main class="page-shell main">
    <section class="hero-shell fade-in-up stagger-1">
      <div class="hero-copy">
        <div class="hero-kicker">Modern quizzes • Real progress</div>
        <h1 class="hero-title"><span class="gradient-text">Sharpen your skills</span>, one quiz at a time.</h1>
        <p class="hero-text">Take quick quizzes, track results, and improve steadily with instant scoring.</p>

        <div class="btn-row">
          <a class="button-primary" href="/quiz">Explore Quizzes</a>
          <% if (username) { %>
            <a class="button-secondary" href="/user/results">View Results</a>
          <% } %>
          <% if (role === 'admin') { %>
            <a class="button-secondary" href="/admin">Open Admin Dashboard</a>
          <% } %>
        </div>

        <% if (username) { %>
          <p class="muted" style="margin: 1rem 0 0;">Welcome back, <strong><%= username %></strong>.</p>
        <% } else { %>
          <p class="muted" style="margin: 1rem 0 0;">Log in to save attempts and see your history.</p>
        <% } %>
      </div>
    </section>

    <section class="section fade-in-up stagger-2">
      <div class="metric-grid">
        <div class="metric-card">
          <div class="metric-label">Total Quizzes</div>
          <div class="metric-value"><%= stats?.quizzes ?? 0 %></div>
          <div class="metric-note">Fresh content added regularly</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Registered Users</div>
          <div class="metric-value"><%= stats?.users ?? 0 %></div>
          <div class="metric-note">Join the leaderboard</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Quiz Attempts</div>
          <div class="metric-value"><%= stats?.attempts ?? 0 %></div>
          <div class="metric-note">Keep the streak going</div>
        </div>
      </div>
    </section>

    <section class="section fade-in-up stagger-3">
      <div class="section-header">
        <div>
          <div class="section-kicker">Featured</div>
          <h2 class="section-title">Latest quizzes</h2>
          <p class="section-text">Pick one and start instantly.</p>
        </div>
        <div>
          <a class="button-secondary" href="/quiz">View all</a>
        </div>
      </div>

      <% if (!featuredQuizzes || featuredQuizzes.length === 0) { %>
        <div class="panel empty-state">No quizzes available yet.</div>
      <% } else { %>
        <div class="quiz-grid">
          <% featuredQuizzes.forEach((quizItem) => { %>
            <article class="quiz-card">
              <div style="display:flex; align-items:center; justify-content:space-between; gap: 0.75rem;">
                <h3 class="truncate" title="<%= quizItem.title %>"><%= quizItem.title %></h3>
                <% if (quizItem.level) { %>
                  <span class="badge"><%= quizItem.level %></span>
                <% } %>
              </div>
              <p><%= quizItem.description || 'Quick quiz to test your knowledge.' %></p>
              <div style="display:flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.9rem;">
                <span class="chip">Questions: <%= quizItem.total_questions %></span>
                <span class="chip">Marks/Q: <%= quizItem.marks_per_question %></span>
              </div>
              <a class="button-primary" href="/quiz/<%= quizItem.id %>">Take quiz</a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <footer>
    <div class="page-shell nav-row" style="padding: 1.1rem 0;">
      <div class="footer-note">© <%= new Date().getFullYear() %> QuizMaster</div>
      <div class="footer-note text-right">Node.js • Express • PostgreSQL (with pg-mem fallback)</div>
    </div>
  </footer>
</body>
</html>
