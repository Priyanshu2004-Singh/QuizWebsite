<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard | QuizMaster</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>

  <nav>
    <div class="page-shell nav-row">
      <div class="nav-left">
        <a class="nav-brand" href="/admin">Admin</a>
        <span class="chip">Participants</span>
      </div>
      <div class="nav-right">
        <a class="secondary-btn" href="/admin">Dashboard</a>
        <a class="button-secondary" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="page-shell main">
    <section class="section">
      <% if (success && success.length) { %>
        <div class="panel success"><%= success %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="panel error"><%= error %></div>
      <% } %>
    </section>

    <section class="section split-grid">
      <div class="panel">
        <h3 class="section-subtitle">➕ Add New Participant</h3>
        <form action="/admin/participants" method="POST" class="form-shell">
          <div>
            <label>Username</label>
            <input type="text" name="username" required />
          </div>
          <div>
            <label>Password</label>
            <input type="password" name="password" required />
          </div>
          <div>
            <label>Initial Marks (optional)</label>
            <input type="number" name="marks" />
          </div>
          <div>
            <button type="submit" class="button">Add Participant</button>
          </div>
        </form>
      </div>
        <div class="panel">
          <h3 class="section-subtitle">➕ Add New Participant</h3>
          <form action="/admin/participants" method="POST" class="form-shell">
            <div>
              <label>Username</label>
              <input name="username" required />
            </div>
            <div>
              <label>Password</label>
              <input type="password" name="password" required />
            </div>
            <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:0.5rem;">
              <button type="submit" class="button">Add Participant</button>
              <a class="secondary-btn" href="/admin/participants/export<% if (q) { %>?q=<%= encodeURIComponent(q) %><% } %>">Export CSV</a>
            </div>
          </form>
        </div>

      <div class="panel">
        <h3 class="section-subtitle">📋 Participant Scores</h3>
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Username</th>
                <th>Marks</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (participants && participants.length > 0) { %>
                <% participants.forEach((p, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><%= p.username %></td>
                    <td><%= p.marks %></td>
                    <td>
                      <form action="/admin/participants/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this user?')">
                        <button class="button-secondary">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="muted">No participants yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <h3 class="section-subtitle">📋 Participant Scores</h3>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
          <form method="GET" action="/admin/participants">
            <input type="search" name="q" placeholder="Search username" value="<%= q %>" />
            <button class="secondary-btn" type="submit">Search</button>
          </form>
          <div class="muted">Total: <%= total %></div>
        </div>
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Username</th>
                <th>Best Score</th>
                <th>Attempts</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (participants && participants.length > 0) { %>
                <% participants.forEach((p, index) => { %>
                  <tr>
                    <td><%= (page - 1) * perPage + index + 1 %></td>
                    <td><%= p.username %></td>
                    <td><%= p.best_score %></td>
                    <td><%= p.attempts %></td>
                    <td>
                      <form action="/admin/participants/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this user?')">
                        <button class="button-secondary">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="muted">No participants yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div style="margin-top:0.8rem; display:flex; gap:0.5rem; align-items:center;">
          <% const lastPage = Math.max(1, Math.ceil(total / perPage)); %>
          <% if (page > 1) { %>
            <a class="secondary-btn" href="/admin/participants?page=<%= page - 1 %><% if (q) { %>&q=<%= encodeURIComponent(q) %><% } %>">Prev</a>
          <% } %>
          <div class="muted">Page <%= page %> / <%= lastPage %></div>
          <% if (page < lastPage) { %>
            <a class="secondary-btn" href="/admin/participants?page=<%= page + 1 %><% if (q) { %>&q=<%= encodeURIComponent(q) %><% } %>">Next</a>
          <% } %>
        </div>
      </div>
    </section>
  </main>

</body>
</html>