<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login | QuizMaster</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/app.css?v=2" />
</head>

<body>
    <nav>
        <div class="page-shell nav-row">
            <div class="nav-left">
                <a class="nav-brand" href="/">QuizMaster</a>
                <span class="chip">Sign in</span>
            </div>
            <div class="nav-right">
                <a class="button-secondary" href="/">Home</a>
                <a class="button-secondary" href="/register">Register</a>
            </div>
        </div>
    </nav>

    <main class="page-shell main">
        <% if (messages?.success?.length || messages?.error?.length) { %>
            <% if (messages?.success?.length) { %>
                <div class="flash-shell flash-success"><%= messages.success.join(' ') %></div>
            <% } %>
            <% if (messages?.error?.length) { %>
                <div class="flash-shell flash-error"><%= messages.error.join(' ') %></div>
            <% } %>
        <% } %>

        <section class="form-shell narrow fade-in-up stagger-1">
            <h1 class="form-title"><span class="gradient-text">Welcome back</span></h1>
            <p class="form-subtitle">Log in to take quizzes and track results.</p>

            <form action="/login" method="POST" class="form-stack">
                <div class="form-stack">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" autocomplete="username" required />
                </div>

                <div class="form-stack">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required />
                </div>

                <div class="btn-row" style="justify-content: space-between; align-items: center;">
                    <button type="submit" class="button-primary">Login</button>
                    <a class="button-secondary" href="/register">Create account</a>
                </div>
            </form>
        </section>
    </main>
</body>

</html>